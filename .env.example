# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where ForgeFlow AI is hosted in production.
# Example: https://forgeflow-ai.run.app
APP_URL="MY_APP_URL"

# SHARED_APP_URL: Optional preview / shared app URL
SHARED_APP_URL=""

# GITHUB_CLIENT_ID: GitHub OAuth Client ID (from GitHub Developer Settings)
GITHUB_CLIENT_ID=""

# GITHUB_CLIENT_SECRET: GitHub OAuth Client Secret
GITHUB_CLIENT_SECRET=""

# GITHUB_CALLBACK_URL: Explicit OAuth callback URL for production
# Example: https://forgeflow-ai.run.app/api/auth/github/callback
GITHUB_CALLBACK_URL=""

# PORT: Server listening port (defaults to 3000)
PORT="3000"
